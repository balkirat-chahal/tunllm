{
  "name": "tunllm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n stun,signal,desktop,app -c yellow,cyan,green,magenta \"pnpm stun\" \"pnpm signaling\" \"pnpm desktop\" \"pnpm --dir app dev\"",
    "stun": "tsx watch stun.ts",
    "signaling": "tsx watch signaling.ts",
    "desktop": "wait-on tcp:127.0.0.1:3001 && tsx watch desktop.ts",
    "app": "pnpm --dir app dev",
    "typecheck": "tsc --noEmit && pnpm --dir app exec tsc -b --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.13",
    "node-datachannel": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "wait-on": "^9.5.1"
  }
}
